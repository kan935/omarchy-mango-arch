#!/bin/bash

# omarchy:summary=Set the branch for Omarchy's git repository.
# omarchy:args=<main|rc|dev>

if (($# == 0)); then
  echo "Usage: omarchy-branch-set [main|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "main" && $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: main, master, rc, dev"
  exit 1
fi

git -C $OMARCHY_PATH switch $branch
